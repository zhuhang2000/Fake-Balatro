{
  "name": "jokecard",
  "version": "1.0.0",
  "description": "一个零外部依赖的像素纸牌游戏原型",
  "main": "src/main.ts",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "lint": "biome check .",
    "lint:write": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test:compile": "tsc -p tsconfig.test.json",
    "knip": "knip",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "npm run test:compile && node tests/core.test.js && node tests/card-states.test.js && node tests/events.test.js && node tests/jokers.test.js && node tests/structure.test.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@types/node": "^20.12.12",
    "dependency-cruiser": "^16.3.0",
    "husky": "^9.0.11",
    "knip": "^5.16.0",
    "lint-staged": "^15.2.5",
    "typescript": "^5.4.5",
    "vite": "^8.0.16"
  }
}
